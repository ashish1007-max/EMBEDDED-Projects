    {
        "id": "f3c77a428962c9d3",
        "type": "function",
        "z": "58713c023c4d3f26",
        "name": "function 3",
        "func": "let current = flow.get(\"current\") || \"\";\nlet num1 = flow.get(\"num1\");\nlet operator = flow.get(\"operator\");\n\nlet key = msg.payload.toString();\n\n// Number pressed\nif (!isNaN(key)) {\n    current += key;\n    flow.set(\"current\", current);\n\n    msg.payload = current;\n    return msg;\n}\n\n// Operator pressed (+ - * /)\nif (key === \"+\" || key === \"-\" || key === \"*\" || key === \"/\") {\n    flow.set(\"num1\", Number(current));\n    flow.set(\"operator\", key);\n    flow.set(\"current\", \"\");\n\n    msg.payload = key;\n    return msg;\n}\n\n// Equals pressed\nif (key === \"=\") {\n\n    let num2 = Number(current);\n    let result;\n\n    switch (operator) {\n\n        case \"+\":\n            result = num1 + num2;\n            break;\n\n        case \"-\":\n            result = num1 - num2;\n            break;\n\n        case \"*\":\n            result = num1 * num2;\n            break;\n\n        case \"/\":\n            if (num2 === 0) {\n                result = \"Error: Divide by 0\";\n            } else {\n                result = num1 / num2;\n            }\n            break;\n\n        default:\n            result = \"Invalid\";\n    }\n\n    flow.set(\"current\", \"\");\n    flow.set(\"num1\", null);\n    flow.set(\"operator\", null);\n\n    msg.payload = result;\n    return msg;\n}\n\n// Clear pressed\nif (key === \"C\") {\n    flow.set(\"current\", \"\");\n    flow.set(\"num1\", null);\n    flow.set(\"operator\", null);\n\n    msg.payload = \"Cleared\";\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
